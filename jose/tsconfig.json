{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true,
    "paths": { "@compartilhado/*": ["./compartilhado/*"] }
  },
  "include": ["scripts", "app/src", "servidor/src", "compartilhado", "testes", "app/vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
